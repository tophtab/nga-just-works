<?xml version="1.0" encoding="utf-8"?>
<!-- Miuix Switch track (SwitchDefaults): 49x28dp capsule, primary when checked, secondary otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="49dp" android:height="28dp" />
            <corners android:radius="14dp" />
            <solid android:color="@color/miuix_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="49dp" android:height="28dp" />
            <corners android:radius="14dp" />
            <solid android:color="@color/miuix_secondary" />
        </shape>
    </item>
</selector>
